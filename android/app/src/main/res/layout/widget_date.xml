<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/date_widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="14dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginRight="16dp">
        <TextView android:id="@+id/d_num" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="–"
            android:textColor="#0f766e" android:textSize="34sp" android:textStyle="bold"/>
        <TextView android:id="@+id/d_wk" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=""
            android:textColor="#8a8478" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/d_list" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textColor="#292524"
        android:textSize="13sp" android:lineSpacingExtra="5dp"/>
</LinearLayout>
