<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="今日课程"
        android:textColor="#0f766e" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text=""
        android:textColor="#8a8478" android:textSize="10sp"/>
    <TextView android:id="@+id/w_list" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#292524" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
</LinearLayout>
